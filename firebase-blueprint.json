{
  "entities": {
    "StudentSession": {
      "title": "StudentSession",
      "description": "Represents a student's Digital SAT exam session, adaptive routing, and Rasch score breakdown.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique session identifier",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fullName": {
          "type": "string",
          "description": "Student full name",
          "minLength": 1,
          "maxLength": 120
        },
        "password": {
          "type": "string",
          "description": "Student session access password",
          "minLength": 1,
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "enum": ["in_progress", "break", "completed"],
          "maxLength": 32
        },
        "currentModule": {
          "type": "string",
          "enum": ["rw_1", "rw_2", "math_1", "math_2"],
          "maxLength": 16
        },
        "currentQuestionIndex": {
          "type": "number",
          "description": "Zero-based index of active question in module"
        },
        "viewMode": {
          "type": "string",
          "enum": ["question", "review"],
          "maxLength": 16
        },
        "startedAt": {
          "type": "string",
          "maxLength": 64
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": [
        "id",
        "fullName",
        "password",
        "status",
        "currentModule",
        "currentQuestionIndex",
        "viewMode",
        "startedAt",
        "updatedAt"
      ]
    },
    "SATQuestion": {
      "title": "SATQuestion",
      "description": "Represents a Digital SAT question with Rasch IRT calibration parameters.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "moduleId": {
          "type": "string",
          "enum": ["rw_1", "rw_2", "math_1", "math_2"],
          "maxLength": 16
        },
        "number": {
          "type": "number"
        },
        "type": {
          "type": "string",
          "enum": ["mcq", "spr"],
          "maxLength": 16
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "correctAnswer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "skill": {
          "type": "string",
          "maxLength": 120
        },
        "difficulty": {
          "type": "string",
          "enum": ["easy", "medium", "hard"],
          "maxLength": 16
        },
        "variant": {
          "type": "string",
          "enum": ["easy", "hard"],
          "maxLength": 16
        },
        "scored": {
          "type": "boolean"
        },
        "b": {
          "type": "number"
        },
        "bSE": {
          "type": "number"
        },
        "infit": {
          "type": "number"
        },
        "outfit": {
          "type": "number"
        },
        "calibratedAt": {
          "type": "number"
        }
      },
      "required": ["id", "moduleId", "number", "type", "prompt", "correctAnswer"]
    },
    "ScoringConfig": {
      "title": "ScoringConfig",
      "description": "Rasch IRT scaling and Stage 2 routing parameters.",
      "type": "object",
      "properties": {
        "version": { "type": "number" },
        "A_rw": { "type": "number" },
        "B_rw": { "type": "number" },
        "A_math": { "type": "number" },
        "B_math": { "type": "number" },
        "cutRW": { "type": "number" },
        "cutMath": { "type": "number" },
        "extremeAdjust": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": [
        "version",
        "A_rw",
        "B_rw",
        "A_math",
        "B_math",
        "cutRW",
        "cutMath",
        "extremeAdjust",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/StudentSession" },
      "description": "Stores real-time student exam sessions, adaptive routing, and Rasch results"
    },
    "/questions/{questionId}": {
      "schema": { "$ref": "#/entities/SATQuestion" },
      "description": "Stores SAT exam questions and Rasch IRT item parameters"
    },
    "/config/{docId}": {
      "schema": { "$ref": "#/entities/ScoringConfig" },
      "description": "Stores psychometric scoring configuration (/config/scoring)"
    }
  }
}
